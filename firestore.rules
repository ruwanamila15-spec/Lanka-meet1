rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.admin == true;
    }

    function isActiveUser() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.get("blocked", false) != true;
    }

    function validPackage(packageId, packageName, packagePrice) {
      return packageId is string
        && packageId.size() > 0
        && exists(
          /databases/$(database)/documents/packages/$(packageId)
        )
        && get(
          /databases/$(database)/documents/packages/$(packageId)
        ).data.enabled == true
        && get(
          /databases/$(database)/documents/packages/$(packageId)
        ).data.name == packageName
        && get(
          /databases/$(database)/documents/packages/$(packageId)
        ).data.price == packagePrice;
    }

    match /users/{userId} {
      allow read: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
        );

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == "user";

      allow update: if isAdmin()
        || (
          isActiveUser()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(["name"])
        );

      allow delete: if isAdmin();
    }

    match /ads/{adId} {

      // PUBLIC USERS CAN ONLY READ APPROVED + PAID ADS.
      // ADMIN CAN READ EVERYTHING.
      allow read: if isAdmin()
        || (
          resource.data.adminApproved == true
          && resource.data.paymentStatus == "paid"
        );

      allow create: if isActiveUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.paymentStatus == "pending"
        && request.resource.data.adminApproved == false
        && request.resource.data.packageId is string
        && request.resource.data.packageName is string
        && request.resource.data.packagePrice is number
        && validPackage(
          request.resource.data.packageId,
          request.resource.data.packageName,
          request.resource.data.packagePrice
        )
        && request.resource.data.paymentId is string
        && request.resource.data.paymentId.size() > 0
        && getAfter(
          /databases/$(database)/documents/payments/$(request.resource.data.paymentId)
        ).data.adId == adId
        && getAfter(
          /databases/$(database)/documents/payments/$(request.resource.data.paymentId)
        ).data.userId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/payments/$(request.resource.data.paymentId)
        ).data.packageId == request.resource.data.packageId
        && getAfter(
          /databases/$(database)/documents/payments/$(request.resource.data.paymentId)
        ).data.amount == request.resource.data.packagePrice;

      allow update: if isAdmin()
        || (
          isActiveUser()
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(["likes"])
          && request.resource.data.likes == resource.data.likes + 1
        );

      allow delete: if isAdmin();
    }

    match /likes/{likeId} {
      allow read: if isActiveUser()
        && resource.data.userId == request.auth.uid;

      allow create: if isActiveUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.adId is string
        && request.resource.data.adId.size() > 0
        && likeId == request.auth.uid + "_" + request.resource.data.adId
        && exists(
          /databases/$(database)/documents/ads/$(request.resource.data.adId)
        )
        && get(
          /databases/$(database)/documents/ads/$(request.resource.data.adId)
        ).data.adminApproved == true
        && get(
          /databases/$(database)/documents/ads/$(request.resource.data.adId)
        ).data.paymentStatus == "paid";

      allow update, delete: if false;
    }

    match /savedAds/{savedId} {
      allow read: if isActiveUser()
        && (
          resource == null
          || resource.data.userId == request.auth.uid
        );

      allow create: if isActiveUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.adId is string
        && savedId == request.auth.uid + "_" + request.resource.data.adId
        && exists(
          /databases/$(database)/documents/ads/$(request.resource.data.adId)
        )
        && get(
          /databases/$(database)/documents/ads/$(request.resource.data.adId)
        ).data.adminApproved == true
        && get(
          /databases/$(database)/documents/ads/$(request.resource.data.adId)
        ).data.paymentStatus == "paid";

      allow update: if false;

      allow delete: if isActiveUser()
        && resource.data.userId == request.auth.uid;
    }

    match /payments/{paymentId} {
      allow read: if isAdmin();

      allow create: if isActiveUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.adId is string
        && request.resource.data.adId.size() > 0
        && request.resource.data.packageId is string
        && request.resource.data.packageName is string
        && request.resource.data.amount is number
        && validPackage(
          request.resource.data.packageId,
          request.resource.data.packageName,
          request.resource.data.amount
        )
        && request.resource.data.status == "pending"
        && request.resource.data.paymentStatus == "receipt_submitted"
        && request.resource.data.adminApproved == false
        && request.resource.data.receiptSentViaWhatsApp == true
        && request.resource.data.reference is string
        && request.resource.data.reference.size() > 0
        && getAfter(
          /databases/$(database)/documents/ads/$(request.resource.data.adId)
        ).data.paymentId == paymentId
        && getAfter(
          /databases/$(database)/documents/ads/$(request.resource.data.adId)
        ).data.uid == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/ads/$(request.resource.data.adId)
        ).data.packageId == request.resource.data.packageId;

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }


    // PRIVATE VIDEO CALLS: only the caller and accepted callee can access an active call.
    match /calls/{callId} {
      allow create: if isActiveUser()
        && request.resource.data.keys().hasAll([
          "callerUid", "calleeUid", "status", "offer", "createdAt", "updatedAt"
        ])
        && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.calleeUid == null
        && request.resource.data.status == "ringing"
        && request.resource.data.offer is map
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow get: if isActiveUser()
        && (
          resource.data.callerUid == request.auth.uid
          || resource.data.calleeUid == request.auth.uid
          || (
            resource.data.status == "ringing"
            && resource.data.calleeUid == null
          )
        );

      allow list: if false;

      allow update: if isActiveUser() && (
        (
          resource.data.callerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["status", "endedAt", "updatedAt"])
          && request.resource.data.callerUid == resource.data.callerUid
          && request.resource.data.calleeUid == resource.data.calleeUid
          && request.resource.data.status == "ended"
        )
        ||
        (
          resource.data.status == "ringing"
          && resource.data.calleeUid == null
          && request.resource.data.calleeUid == request.auth.uid
          && request.resource.data.callerUid == resource.data.callerUid
          && request.resource.data.status == "answered"
          && request.resource.data.answer is map
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["calleeUid", "answer", "status", "updatedAt"])
        )
        ||
        (
          resource.data.calleeUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["status", "endedAt", "updatedAt"])
          && request.resource.data.callerUid == resource.data.callerUid
          && request.resource.data.calleeUid == resource.data.calleeUid
          && request.resource.data.status == "ended"
        )
      );

      allow delete: if false;

      match /callerCandidates/{candidateId} {
        allow read: if isActiveUser()
          && (
            get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid
            || get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid
          );
        allow create: if isActiveUser()
          && request.resource.data.uid == request.auth.uid
          && get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid;
        allow update, delete: if false;
      }

      match /calleeCandidates/{candidateId} {
        allow read: if isActiveUser()
          && (
            get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid
            || get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid
          );
        allow create: if isActiveUser()
          && request.resource.data.uid == request.auth.uid
          && get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
